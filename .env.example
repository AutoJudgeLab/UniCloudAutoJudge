# Copy to .env; supply your own credentials. Keep values shell-compatible.
# Generate each password independently, for example: openssl rand -hex 24
POSTGRES_DB=online_judge
POSTGRES_USER=judge
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/online_judge

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ROOT_USER=
# MinIO requires a password of at least 8 characters.
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Reclaim incomplete multipart uploads independently of completed-object cleanup.
MINIO_STALE_UPLOADS_EXPIRY=24h
MINIO_STALE_UPLOADS_CLEANUP_INTERVAL=1h

# Separate, bucket-scoped application credentials; never use MinIO root here.
# Provision using the storage-init Compose profile; see docs/storage.md.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=judge-private
S3_REGION=us-east-1
S3_MAX_UPLOAD_SIZE=1MB
# HTTP multipart envelope limit, including overhead; larger than max upload size.
S3_MAX_REQUEST_SIZE=2MB
S3_ALLOWED_EXTENSIONS=java,py,c,cpp,js,ts,kt,go,rs,cs
S3_REQUEST_TIMEOUT=10s

SUBMISSION_CLEANUP_ENABLED=true
SUBMISSION_CLEANUP_INTERVAL=PT1M
SUBMISSION_CLEANUP_INITIAL_DELAY=15m
SUBMISSION_CLEANUP_RETRY_DELAY=1h
SUBMISSION_CLEANUP_BATCH_SIZE=20

SERVER_PORT=8081
OPENAPI_ENABLED=true

# local or portal; see docs/portal-sso.md. Portal mode disables local login/register.
AUTHENTICATION_MODE=local
PORTAL_ISSUER=https://unicloud-portal-staging.onrender.com
PORTAL_CLIENT_ID=unicloud-auto-judge
PORTAL_CLIENT_SECRET=HJ_ReyZ09ZvappBr5y-Xm_TEdfwV-UBD4n1sZwLaS8E
PORTAL_REDIRECT_URI=http://localhost:8081/login/oauth2/code/portal
# Comma-separated Portal subjects approved as Judge admins; must also have Portal ADMIN role.
PORTAL_ADMIN_SUBJECTS=13
# Timeout for per-request UserInfo; warm staging before login.
PORTAL_REQUEST_TIMEOUT=10s

# Required only in local mode: matching RSA keys, at least 2048 bits. See docs/authentication.md.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=online-judge
JWT_AUDIENCE=judge-api
JWT_ACCESS_TOKEN_TTL=15m

# Shared across API instances. Redis failure returns 503 for login/register.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_LIMIT=5
AUTH_REGISTER_LIMIT=3
AUTH_RATE_LIMIT_WINDOW=1m

# Separate random evaluator credential, e.g. openssl rand -hex 32.
# Configure the same token in the API and worker; it is not a user JWT.
WORKER_TRANSPORT_ENABLED=false
JUDGE_WORKER_TOKEN=
WORKER_ATTEMPT_LEASE=4m
JUDGE_API_BASE_URL=http://localhost:8081
# Active attempts renew both leases; keep enough headroom for network latency.
WORKER_RECLAIM_IDLE=5m
WORKER_RECOVERY_INTERVAL=PT1M
WORKER_RECOVERY_MINIMUM_AGE=5m
WORKER_WORKSPACE_BYTES=536870912
WORKER_WORKSPACE_FILES=10000

# Enable only for initial provisioning; disable and remove credentials afterward.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional Redis ACL username and TLS for production deployments.
REDIS_USERNAME=
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_SUBMISSION_STREAM=judge:submissions:v1
REDIS_STREAM_MAX_LENGTH=100000
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL=PT1S
OUTBOX_RETRY_INITIAL_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
METRICS_SNAPSHOT_INTERVAL=PT30S
LOG_FORMAT=ecs
